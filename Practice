SELECT 
    category, 
    SUM(price * quantity) AS total_revenue,
    COUNT(order_id) AS sale_count
FROM sales_table
GROUP BY category
HAVING COUNT(order_id) > 5
ORDER BY total_revenue DESC
LIMIT 1;



