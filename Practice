-- Get all employees in the Engineering department
SELECT name, salary 
FROM employees 
WHERE department = 'Engineering';

-- Give a raise to everyone in Marketing
UPDATE employees 
SET salary = salary * 1.10 
WHERE department = 'Marketing';


